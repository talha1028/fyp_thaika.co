graph ERD {
  graph [layout=neato, mode=KK, overlap=prism, splines=line, sep="+0.4", esep="+0.2", maxiter=8000, epsilon=0.0001, labelloc="t", fontname="Arial Bold", fontsize=18, label="Part 2 of 6 - Jobs & Bidding", bgcolor="white"];
  node [fontname="Arial", fontsize=12, penwidth=1.4];
  edge [fontname="Arial", fontsize=11, color="#000000", penwidth=1.1];
  n_e_job [label="Job", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_job_jobid [label=<<u>jobId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_jobid [len=0.38, weight=40];
  n_a_job_clientid_fk [label="clientId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_clientid_fk [len=0.38, weight=40];
  n_a_job_title [label="title", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_title [len=0.38, weight=40];
  n_a_job_category [label="category", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_category [len=0.38, weight=40];
  n_a_job_budget [label="budget", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_budget [len=0.38, weight=40];
  n_a_job_timeline [label="timeline", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_timeline [len=0.38, weight=40];
  n_a_job_location [label="location", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_location [len=0.38, weight=40];
  n_a_job_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_status [len=0.38, weight=40];
  n_a_job_acceptedbidid_fk [label="acceptedBidId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_acceptedbidid_fk [len=0.38, weight=40];
  n_a_job_assignedcontractorid_fk [label="assignedContractorId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_assignedcontractorid_fk [len=0.38, weight=40];
  n_e_bid [label="Bid", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_bid_bidid [label=<<u>bidId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_bidid [len=0.38, weight=40];
  n_a_bid_jobid_fk [label="jobId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_jobid_fk [len=0.38, weight=40];
  n_a_bid_contractorid_fk [label="contractorId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_contractorid_fk [len=0.38, weight=40];
  n_a_bid_bidamount [label="bidAmount", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_bidamount [len=0.38, weight=40];
  n_a_bid_completiondays [label="completionDays", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_completiondays [len=0.38, weight=40];
  n_a_bid_proposal [label="proposal", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_proposal [len=0.38, weight=40];
  n_a_bid_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_bid -- n_a_bid_status [len=0.38, weight=40];
  n_e_user [label="User", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_user_userid [label=<<u>userId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_userid [len=0.38, weight=40];
  n_a_user_usertype [label="userType", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_usertype [len=0.38, weight=40];
  n_a_user_fullname [label="fullName", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_fullname [len=0.38, weight=40];
  n_r_0_posts [label="posts", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_0_posts [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_0_posts -- n_e_job [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_1_assigned_to [label="assigned to", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_1_assigned_to [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_1_assigned_to -- n_e_job [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_2_attracts [label="attracts", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_2_attracts [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_2_attracts -- n_e_bid [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_3_submits [label="submits", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_3_submits [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_3_submits -- n_e_bid [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_4_accepts [label="accepts", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_4_accepts [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_4_accepts -- n_e_bid [label="1", len=1.55, weight=2, penwidth=1.4];
  n_note_0 [label="-> shown in full in\nPart 1 (Accounts)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_user -- n_note_0 [style=invis, len=0.7, weight=8];
  n_note_1 [label="-> continues in\nPart 3 (Contracts)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_job -- n_note_1 [style=invis, len=0.7, weight=8];
}
