graph ERD {
  graph [layout=neato, mode=KK, overlap=prism, splines=line, sep="+0.4", esep="+0.2", maxiter=8000, epsilon=0.0001, labelloc="t", fontname="Arial Bold", fontsize=18, label="Part 3 of 6 - Contracts & Payments", bgcolor="white"];
  node [fontname="Arial", fontsize=12, penwidth=1.4];
  edge [fontname="Arial", fontsize=11, color="#000000", penwidth=1.1];
  n_e_contract [label="Contract", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_contract_contractid [label=<<u>contractId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_contract -- n_a_contract_contractid [len=0.38, weight=40];
  n_a_contract_jobid_fk [label="jobId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_contract -- n_a_contract_jobid_fk [len=0.38, weight=40];
  n_a_contract_clientid_fk [label="clientId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_contract -- n_a_contract_clientid_fk [len=0.38, weight=40];
  n_a_contract_contractorid_fk [label="contractorId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_contract -- n_a_contract_contractorid_fk [len=0.38, weight=40];
  n_a_contract_pdfurl [label="pdfUrl", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_contract -- n_a_contract_pdfurl [len=0.38, weight=40];
  n_a_contract_clientemailsent [label="clientEmailSent", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_contract -- n_a_contract_clientemailsent [len=0.38, weight=40];
  n_e_payment [label="Payment", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_payment_paymentid [label=<<u>paymentId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_paymentid [len=0.38, weight=40];
  n_a_payment_jobid_fk [label="jobId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_jobid_fk [len=0.38, weight=40];
  n_a_payment_clientid_fk [label="clientId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_clientid_fk [len=0.38, weight=40];
  n_a_payment_contractorid_fk [label="contractorId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_contractorid_fk [len=0.38, weight=40];
  n_a_payment_amount [label="amount", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_amount [len=0.38, weight=40];
  n_a_payment_paymenttype [label="paymentType", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_paymenttype [len=0.38, weight=40];
  n_a_payment_paymentmethod [label="paymentMethod", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_paymentmethod [len=0.38, weight=40];
  n_a_payment_transactionref [label="transactionRef", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_transactionref [len=0.38, weight=40];
  n_a_payment_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_payment -- n_a_payment_status [len=0.38, weight=40];
  n_e_mail [label="Mail", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_mail_id [label=<<u>id</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_mail -- n_a_mail_id [len=0.38, weight=40];
  n_a_mail_to_array [label="to (array)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_mail -- n_a_mail_to_array [len=0.38, weight=40];
  n_a_mail_subject [label="subject", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_mail -- n_a_mail_subject [len=0.38, weight=40];
  n_a_mail_html [label="html", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_mail -- n_a_mail_html [len=0.38, weight=40];
  n_e_job [label="Job", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_job_jobid [label=<<u>jobId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_jobid [len=0.38, weight=40];
  n_a_job_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_status [len=0.38, weight=40];
  n_e_user [label="User", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_user_userid [label=<<u>userId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_userid [len=0.38, weight=40];
  n_a_user_email [label="email", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_email [len=0.38, weight=40];
  n_r_0_generates [label="generates", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_0_generates [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_0_generates -- n_e_contract [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_1_settled_by [label="settled by", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_1_settled_by [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_1_settled_by -- n_e_payment [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_2_pays [label="pays", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_2_pays [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_2_pays -- n_e_payment [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_3_emailed_as [label="emailed as", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_contract -- n_r_3_emailed_as [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_3_emailed_as -- n_e_mail [label="N", len=1.55, weight=2, penwidth=1.4];
  n_note_0 [label="-> shown in full in\nPart 2 (Jobs)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_job -- n_note_0 [style=invis, len=0.7, weight=8];
  n_note_1 [label="deposit 30% / final 70%", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_payment -- n_note_1 [style=invis, len=0.7, weight=8];
}
