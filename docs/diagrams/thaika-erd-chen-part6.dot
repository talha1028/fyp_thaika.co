graph ERD {
  graph [layout=neato, mode=KK, overlap=prism, splines=line, sep="+0.4", esep="+0.2", maxiter=8000, epsilon=0.0001, labelloc="t", fontname="Arial Bold", fontsize=18, label="Part 6 of 6 - Reviews & Ratings", bgcolor="white"];
  node [fontname="Arial", fontsize=12, penwidth=1.4];
  edge [fontname="Arial", fontsize=11, color="#000000", penwidth=1.1];
  n_e_review [label="Review", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_review_reviewid [label=<<u>reviewId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_reviewid [len=0.38, weight=40];
  n_a_review_jobid_fk [label="jobId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_jobid_fk [len=0.38, weight=40];
  n_a_review_clientid_fk [label="clientId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_clientid_fk [len=0.38, weight=40];
  n_a_review_contractorid_fk [label="contractorId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_contractorid_fk [len=0.38, weight=40];
  n_a_review_rating [label="rating", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_rating [len=0.38, weight=40];
  n_a_review_reviewtext [label="reviewText", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_reviewtext [len=0.38, weight=40];
  n_a_review_isverified [label="isVerified", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_isverified [len=0.38, weight=40];
  n_a_review_response [label="response", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_review -- n_a_review_response [len=0.38, weight=40];
  n_e_job [label="Job", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_job_jobid [label=<<u>jobId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_jobid [len=0.38, weight=40];
  n_a_job_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_status [len=0.38, weight=40];
  n_e_user [label="User", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_user_userid [label=<<u>userId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_userid [len=0.38, weight=40];
  n_a_user_usertype [label="userType", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_usertype [len=0.38, weight=40];
  n_a_user_rating [label="rating", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_rating [len=0.38, weight=40];
  n_r_0_rated_by [label="rated by", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_0_rated_by [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_0_rated_by -- n_e_review [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_1_writes [label="writes", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_1_writes [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_1_writes -- n_e_review [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_2_receives [label="receives", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_2_receives [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_2_receives -- n_e_review [label="N", len=1.55, weight=2, penwidth=1.4];
  n_note_0 [label="-> shown in full in\nPart 2 (Jobs)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_job -- n_note_0 [style=invis, len=0.7, weight=8];
  n_note_1 [label="-> shown in full in\nPart 1 (Accounts)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_user -- n_note_1 [style=invis, len=0.7, weight=8];
}
