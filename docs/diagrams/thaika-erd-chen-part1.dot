graph ERD {
  graph [layout=neato, mode=KK, overlap=prism, splines=line, sep="+0.4", esep="+0.2", maxiter=8000, epsilon=0.0001, labelloc="t", fontname="Arial Bold", fontsize=18, label="Part 1 of 6 - Accounts & Notifications", bgcolor="white"];
  node [fontname="Arial", fontsize=12, penwidth=1.4];
  edge [fontname="Arial", fontsize=11, color="#000000", penwidth=1.1];
  n_e_user [label="User", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_user_userid [label=<<u>userId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_userid [len=0.38, weight=40];
  n_a_user_email_unique [label="email (unique)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_email_unique [len=0.38, weight=40];
  n_a_user_fullname [label="fullName", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_fullname [len=0.38, weight=40];
  n_a_user_phonenumber [label="phoneNumber", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_phonenumber [len=0.38, weight=40];
  n_a_user_city [label="city", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_city [len=0.38, weight=40];
  n_a_user_usertype [label="userType", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_usertype [len=0.38, weight=40];
  n_a_user_phoneverified [label="phoneVerified", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_phoneverified [len=0.38, weight=40];
  n_a_user_fcmtoken [label="fcmToken", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_fcmtoken [len=0.38, weight=40];
  n_a_user_category [label="category", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_category [len=0.38, weight=40];
  n_a_user_hourlyrate [label="hourlyRate", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_hourlyrate [len=0.38, weight=40];
  n_a_user_rating [label="rating", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_rating [len=0.38, weight=40];
  n_a_user_totalspent [label="totalSpent", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_totalspent [len=0.38, weight=40];
  n_e_notification [label="Notification", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_notification_notificationid [label=<<u>notificationId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_notification -- n_a_notification_notificationid [len=0.38, weight=40];
  n_a_notification_userid_fk [label="userId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_notification -- n_a_notification_userid_fk [len=0.38, weight=40];
  n_a_notification_title [label="title", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_notification -- n_a_notification_title [len=0.38, weight=40];
  n_a_notification_type [label="type", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_notification -- n_a_notification_type [len=0.38, weight=40];
  n_a_notification_relatedid [label="relatedId", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_notification -- n_a_notification_relatedid [len=0.38, weight=40];
  n_a_notification_isread [label="isRead", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_notification -- n_a_notification_isread [len=0.38, weight=40];
  n_r_0_receives [label="receives", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_0_receives [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_0_receives -- n_e_notification [label="N", len=1.55, weight=2, penwidth=1.4];
  n_note_0 [label="-> continues in\nPart 2 (Jobs)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_user -- n_note_0 [style=invis, len=0.7, weight=8];
  n_omitnote [label="epoch timestamps are omitted from\nall entities on this diagram for space -\ndocuments store created/updated millis.", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_user -- n_omitnote [style=invis, len=1.1, weight=2];
}
