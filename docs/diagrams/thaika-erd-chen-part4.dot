  n_a_material_addedby_fk [label="addedBy (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_addedby_fk [len=0.38, weight=40];
  n_e_job [label="Job", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_job_jobid [label=<<u>jobId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_jobid [len=0.38, weight=40];
  n_a_job_title [label="title", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_job -- n_a_job_title [len=0.38, weight=40];
  n_e_user [label="User", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_user_userid [label=<<u>userId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_userid [len=0.38, weight=40];
  n_a_user_usertype [label="userType", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_user -- n_a_user_usertype [len=0.38, weight=40];
  n_r_0_tracks [label="tracks", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_0_tracks [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_0_tracks -- n_e_task [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_1_consumes [label="consumes", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_job -- n_r_1_consumes [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_1_consumes -- n_e_material [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_2_creates [label="creates", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_2_creates [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_2_creates -- n_e_task [label="N", len=1.55, weight=2, penwidth=1.4];
  n_r_3_adds [label="adds", shape="diamond", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.05,0.02", fontsize="12"];
  n_e_user -- n_r_3_adds [label="1", len=1.55, weight=2, penwidth=1.4];
  n_r_3_adds -- n_e_material [label="N", len=1.55, weight=2, penwidth=1.4];
  n_note_0 [label="-> shown in full in\nPart 2 (Jobs)", shape="box", style="filled", fillcolor="#BDBDBD", color="#000000", fontcolor="#000000", fontsize=10];
  n_e_job -- n_note_0 [style=invis, len=0.7, weight=8];
}
