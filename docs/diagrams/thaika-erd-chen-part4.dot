  n_e_material -- n_a_material_supplier [len=0.38, weight=40];
  n_a_material_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
