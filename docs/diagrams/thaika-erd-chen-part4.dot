  n_e_task -- n_a_task_assignedto [len=0.38, weight=40];
  n_a_task_status [label="status", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_status [len=0.38, weight=40];
  n_a_task_progresspercentage [label="progressPercentage", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_progresspercentage [len=0.38, weight=40];
  n_a_task_totalcost [label="totalCost", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_totalcost [len=0.38, weight=40];
  n_a_task_createdby_fk [label="createdBy (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_createdby_fk [len=0.38, weight=40];
  n_e_material [label="Material", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_material_materialid [label=<<u>materialId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_materialid [len=0.38, weight=40];
  n_a_material_jobid_fk [label="jobId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_jobid_fk [len=0.38, weight=40];
  n_a_material_materialname [label="materialName", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_materialname [len=0.38, weight=40];
  n_a_material_category [label="category", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_category [len=0.38, weight=40];
  n_a_material_quantity [label="quantity", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_quantity [len=0.38, weight=40];
  n_a_material_unit [label="unit", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_unit [len=0.38, weight=40];
  n_a_material_unitprice [label="unitPrice", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_material -- n_a_material_unitprice [len=0.38, weight=40];
