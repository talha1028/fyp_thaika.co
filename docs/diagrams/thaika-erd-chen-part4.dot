graph ERD {
  graph [layout=neato, mode=KK, overlap=prism, splines=line, sep="+0.4", esep="+0.2", maxiter=8000, epsilon=0.0001, labelloc="t", fontname="Arial Bold", fontsize=18, label="Part 4 of 6 - Tasks & Materials", bgcolor="white"];
  node [fontname="Arial", fontsize=12, penwidth=1.4];
  edge [fontname="Arial", fontsize=11, color="#000000", penwidth=1.1];
  n_e_task [label="Task", shape="box", style="filled", fillcolor="#D9D9D9", color="#000000", fontcolor="#000000", margin="0.18,0.12", fontsize="16"];
  n_a_task_taskid [label=<<u>taskId</u>>, shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_taskid [len=0.38, weight=40];
  n_a_task_jobid_fk [label="jobId (FK)", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_jobid_fk [len=0.38, weight=40];
  n_a_task_tasktitle [label="taskTitle", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#000000", fontcolor="#000000", margin="0.04,0.02", fontsize="11"];
  n_e_task -- n_a_task_tasktitle [len=0.38, weight=40];
