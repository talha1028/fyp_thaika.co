<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal pill for secondary AI actions: tinted fill plus a matching outline, so they read as
     interactive features rather than the flat grey chips they were. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EDE7FF" />
    <stroke
        android:width="1dp"
        android:color="#7C4DFF" />
    <corners android:radius="10dp" />
</shape>
