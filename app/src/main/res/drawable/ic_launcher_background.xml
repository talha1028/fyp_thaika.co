<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid white, replacing the Android Studio template's green grid.

  The Thaika.co mark is purple artwork on a white field, so the adaptive foreground bitmap carries
  white around the logo. Matching that here makes the two layers seamless under any launcher mask.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
</shape>
