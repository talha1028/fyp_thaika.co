<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded surface for custom dialogs. The dialog window background is set transparent in code
  so these corners are not squared off by the platform's own white dialog background.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="20dp" />
</shape>
