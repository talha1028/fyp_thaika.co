<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading placeholder for item_contractor_card.xml. Mirrors that card's shell, 60dp avatar and
  name/category/rating stack so the list does not jump when real data swaps in. No ids, not
  clickable - it is inert and gets <include>d several times inside a ShimmerLayout.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_skeleton_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <View
                android:layout_width="150dp"
                android:layout_height="17dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="100dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>

        <View
            android:layout_width="64dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
