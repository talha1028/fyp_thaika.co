<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading placeholder for item_conversation.xml. Mirrors that row's shell, 56dp avatar and text
  block so the list does not jump when real data swaps in. No ids, not clickable - it is inert and
  gets <include>d several times inside a ShimmerLayout.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_skeleton_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Name + time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <!-- Last message, two lines -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
